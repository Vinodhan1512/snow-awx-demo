# Copy to .env and fill in. Never commit .env (it's in .gitignore).

# --- ServiceNow PDI (developer.servicenow.com) ---
SN_INSTANCE=dev12345.service-now.com      # host only, no https://
SN_USERNAME=admin
SN_PASSWORD=

# --- Git repo that holds THIS bundle (AWX pulls playbooks from it) ---
GIT_REPO_URL=https://github.com/Vinodhan1512/snow-awx-demo.git
GIT_BRANCH=main
GIT_USERNAME=                              # only for a private repo
GIT_TOKEN=                                 # only for a private repo (GitHub PAT, read access)

# --- AWX ---
# Existing AWX: set AWX_URL (public https URL) and setup.sh skips the install + tunnel.
# Leave AWX_URL empty to have setup.sh install AWX on this machine instead.
AWX_URL=https://34-249-159-186.sslip.io
AWX_USERNAME=admin
AWX_ADMIN_PASSWORD=
AWX_VERIFY_TLS=true                        # set false if AWX uses a self-signed certificate

# --- Cisco device (DevNet "Catalyst 8000v" on-demand sandbox, reached over its VPN) ---
CISCO_HOST=10.10.20.48
CISCO_USERNAME=developer
CISCO_PASSWORD=
CISCO_INVENTORY_NAME=demo-iosxe            # name shown in ServiceNow "Device" field

# --- Sandbox VPN (sandbox page > Access Details) - used by vpn_setup.py ---
SANDBOX_VPN_HOST=                          # vpn_address, full value including :port
SANDBOX_VPN_USER=
SANDBOX_VPN_PASSWORD=
# Login of the AWX server itself (the job SSHes to its own host to install the VPN client)
AWX_HOST_SSH_USER=vinod
AWX_HOST_SSH_PASSWORD=
AWX_NODE_IP=                               # leave empty; set only if vpn_setup.py cannot find the server

# --- AWS security group use case ---
AWS_REGION=eu-west-1                       # region of the demo SG (your instance IPs look like eu-west-1)
DEMO_SG_ID=sg-xxxxxxxxxxxxxxxxx
# Keys of an IAM user limited to this SG (see README). Leave empty if the AWX host has an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Optional ---
RUN_SMOKE_TEST=true                        # fires a read-only diagnostics incident at the end
